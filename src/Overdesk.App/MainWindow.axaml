<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="using:Overdesk.Core.Tabs"
        xmlns:c="using:Overdesk.App.Controls"
        xmlns:d="using:Overdesk.App.Controls.Depth"
        xmlns:app="using:Overdesk.App"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Overdesk.App.MainWindow"
        Title="OverDesk"
        MinWidth="820" MinHeight="520"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="48"
        Background="{StaticResource Bg0Brush}">
    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*">

        <!-- ======================================================== top bar: logo, home, tabs, + -->
        <Border x:Name="TopBar" Grid.Row="0" Height="48" Background="{StaticResource BarBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1"
                BoxShadow="inset 0 1 0 0 #14FFFFFF"
                chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                <!-- Room for the macOS traffic lights -->
                <Border x:Name="MacCaptionSpace" Grid.Column="0" Width="0"/>

                <Button x:Name="LogoButton" Grid.Column="1" Classes="icon" Width="40" Height="36" Margin="8,0,0,0"
                        ToolTip.Tip="OverDesk menu" chrome:WindowDecorationProperties.ElementRole="User">
                    <c:LogoMark x:Name="TopLogo" Width="25" Height="25" Glow="0.55"
                                Accent="{DynamicResource AccentColor}" Accent2="{DynamicResource Accent2Color}"/>
                </Button>

                <Border Grid.Column="2" Width="1" Height="20" Margin="8,0" Background="{StaticResource StrokeStrongBrush}"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="0,0,6,0">
                    <!-- Workspace switcher: a colored badge + name; each workspace has its own tab row -->
                    <Button x:Name="WorkspaceButton" Classes="workspace" chrome:WindowDecorationProperties.ElementRole="User">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="WorkspaceBadge" Width="20" Height="20" CornerRadius="6">
                                <TextBlock x:Name="WorkspaceInitial" FontSize="10.5" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="WorkspaceName" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                       MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                            <Path Classes="icon small" Data="{StaticResource IconChevronDown}" Height="9"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HomeButton" Classes="icon hometab"
                            chrome:WindowDecorationProperties.ElementRole="User">
                        <Path Classes="icon" Data="{StaticResource IconHome}"/>
                    </Button>
                </StackPanel>

                <ScrollViewer x:Name="TabScroller" Grid.Column="4" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl x:Name="TabStrip" chrome:WindowDecorationProperties.ElementRole="User">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tabs:HostedTab">
                                    <Border Classes="tab" Classes.active="{Binding IsActive}" Classes.internal="{Binding IsInternal}"
                                            ToolTip.Tip="{Binding ProgramPath}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Wash in the program's own icon color (accent for OverDesk's tab) -->
                                            <c:TabTint Grid.ColumnSpan="3" Margin="-11,-1,-6,-1"
                                                       ProgramPath="{Binding ProgramPath}" IsActive="{Binding IsActive}"
                                                       UseAccent="{Binding IsInternal}"
                                                       Accent="{DynamicResource AccentColor}" Accent2="{DynamicResource Accent2Color}"/>
                                            <Panel Width="18" Height="18" VerticalAlignment="Center">
                                                <c:LogoMark IsVisible="{Binding IsSettings}" Glow="0.6"
                                                            Accent="{DynamicResource AccentColor}" Accent2="{DynamicResource Accent2Color}"/>
                                                <Path Classes="icon accent" Data="{StaticResource IconNote}" Height="15"
                                                      IsVisible="{Binding IsWork}"/>
                                                <Panel IsVisible="{Binding !IsInternal}">
                                                    <c:AppIcon ProgramPath="{Binding ProgramPath}" IsVisible="{Binding !IsBusy}"/>
                                                    <c:Spinner Thickness="2" IsVisible="{Binding IsBusy}"
                                                               Accent="{DynamicResource AccentColor}"/>
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource DangerBrush}"
                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                             Margin="0,0,-2,-2" Stroke="{StaticResource Bg1Brush}" StrokeThickness="1.5"
                                                             IsVisible="{Binding HasProblem}"/>
                                                </Panel>
                                            </Panel>
                                            <TextBlock Grid.Column="1" Classes="title" Text="{Binding Title}"/>
                                            <Border Grid.Column="1" Classes="badge" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <Button Grid.Column="2" Classes="icon tabclose" Tag="close" ToolTip.Tip="Close tab">
                                                <Path Classes="icon small" Data="{StaticResource IconClose}"/>
                                            </Button>
                                            <Border Grid.ColumnSpan="3" Classes="tabline"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AddTabButton" Classes="icon" Width="34" Height="34"
                                chrome:WindowDecorationProperties.ElementRole="User">
                            <Path Classes="icon" Data="{StaticResource IconPlus}"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="SettingsButton" Grid.Column="5" Classes="icon" Margin="6,0,10,0"
                        chrome:WindowDecorationProperties.ElementRole="User">
                    <Path Classes="icon" Data="{StaticResource IconSliders}"/>
                </Button>

                <!-- Room for the Windows caption buttons -->
                <Border x:Name="WinCaptionSpace" Grid.Column="6" Width="0"/>
            </Grid>
        </Border>

        <!-- A thin accent light along the bottom edge of the top bar, fading out toward both sides -->
        <Border x:Name="TopGlowLine" Grid.Row="0" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0.6"
                Background="{DynamicResource AccentGradient}">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="Black" Offset="0.35"/>
                    <GradientStop Color="Black" Offset="0.65"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <!-- ======================================================== web strip: websites live apart from programs -->
        <Border x:Name="WebBar" Grid.Row="1" Height="42" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1"
                BoxShadow="inset 0 4 8 -2 #90000000">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#0C0C11" Offset="0"/>
                    <GradientStop Color="#0A0A0F" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="7" Margin="16,0,10,0" VerticalAlignment="Center">
                    <Path Classes="icon accent" Data="{StaticResource IconGlobe}" Height="13"/>
                    <TextBlock Classes="eyebrow" Text="WEB" FontSize="9.5" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="WebPills" Orientation="Horizontal" Spacing="6"/>
                        <Button x:Name="AddSiteButton" Classes="icon" Width="28" Height="28" Margin="6,0,0,0"
                                ToolTip.Tip="Add a website or service">
                            <Path Classes="icon small" Data="{StaticResource IconPlus}"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ======================================================== body: content | splitter | tool panel | tool strip -->
        <Grid x:Name="Body" Grid.Row="2" ColumnDefinitions="Auto,*,Auto,0,58">

            <!-- Left dock: now playing, system, localhost, clipboard, scratchpad -->
            <app:SideDock x:Name="Dock" Grid.Column="0" Width="284"/>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- Missing OS permission -->
                <Border x:Name="PermissionBanner" Grid.Row="0" IsVisible="False" Padding="14,9"
                        Background="#1AFFB547" BorderBrush="#33FFB547" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Classes="icon" Data="{StaticResource IconShield}" Stroke="{StaticResource WarningBrush}"
                              VerticalAlignment="Center"/>
                        <TextBlock x:Name="PermissionText" Grid.Column="1" Margin="12,0" TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontSize="12.5"/>
                        <Button x:Name="GrantButton" Grid.Column="2" Classes="accent" Content="Grant access" Padding="14,6"/>
                    </Grid>
                </Border>

                <Panel Grid.Row="1">
                    <!-- The stage: the active program's window is placed exactly over TabHost, which floats
                         inside a softly glowing frame on top of the animated backdrop, never touching an edge. -->
                    <Grid x:Name="Stage" Background="{StaticResource Bg0Brush}">
                        <c:SigilBackground x:Name="StageWaves" Intensity="0.7"
                                          Accent="{DynamicResource AccentColor}" Accent2="{DynamicResource Accent2Color}"/>
                        <!-- One frame, or two side by side in split view (the second column opens up) -->
                        <Grid x:Name="StageSplit" Margin="16" ColumnDefinitions="*,0,0">
                            <Border x:Name="StageFrame" Grid.Column="0" CornerRadius="14" BorderThickness="1"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BoxShadow="{DynamicResource AccentGlowLarge}"
                                    Background="{StaticResource Bg0Brush}">
                                <Border x:Name="TabHost" Margin="1" CornerRadius="13" Background="{StaticResource Bg0Brush}"
                                        ClipToBounds="True">
                                    <!-- Live image of the program while Overdesk itself is in front (macOS), see Mirror* in code -->
                                    <Image x:Name="Mirror" Stretch="Fill" IsVisible="False" Cursor="Hand"/>
                                </Border>
                            </Border>
                            <!-- Flashes along the frame when the tab changes (see PulseStage) -->
                            <Border x:Name="StagePulse" Grid.Column="0" CornerRadius="14" BorderThickness="1.5" Opacity="0"
                                    IsHitTestVisible="False" BorderBrush="{DynamicResource AccentGradientDiagonal}"
                                    BoxShadow="{DynamicResource AccentGlowLarge}"/>
                            <GridSplitter x:Name="SplitHandle" Grid.Column="1" Background="Transparent" ResizeDirection="Columns"
                                          IsVisible="False"/>
                            <Border x:Name="SplitFrame" Grid.Column="2" CornerRadius="14" BorderThickness="1" IsVisible="False"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BoxShadow="{DynamicResource AccentGlowLarge}"
                                    Background="{StaticResource Bg0Brush}">
                                <Panel>
                                    <Border x:Name="SplitHost" Margin="1" CornerRadius="13" Background="{StaticResource Bg0Brush}"
                                            ClipToBounds="True">
                                        <Image x:Name="SplitMirror" Stretch="Fill" IsVisible="False" Cursor="Hand"/>
                                    </Border>
                                    <StackPanel x:Name="SplitStatus" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                        <c:Spinner Width="40" Height="40" Thickness="3" Accent="{DynamicResource AccentColor}"/>
                                        <TextBlock x:Name="SplitStatusText" Classes="muted" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </Grid>
                    </Grid>

                    <app:HomeView x:Name="Home" IsVisible="False"/>

                    <!-- A website from the web strip, inside the same glowing stage as programs -->
                    <Grid x:Name="WebArea" IsVisible="False" Background="{StaticResource Bg0Brush}">
                        <c:SigilBackground x:Name="WebWaves" Intensity="0.6"
                                          Accent="{DynamicResource AccentColor}" Accent2="{DynamicResource Accent2Color}"/>
                        <Border x:Name="WebFrame" Margin="16" CornerRadius="14" BorderThickness="1"
                                BorderBrush="{DynamicResource AccentBorderBrush}" BoxShadow="{DynamicResource AccentGlowLarge}"
                                Background="{StaticResource Bg1Brush}" ClipToBounds="True">
                            <Grid RowDefinitions="42,Auto,Auto,*">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="8,0">
                                    <Button x:Name="WebBack" Classes="icon" Width="30" Height="30" ToolTip.Tip="Back">
                                        <Path Classes="icon small" Data="{StaticResource IconChevronLeft}"/>
                                    </Button>
                                    <Button x:Name="WebForward" Grid.Column="1" Classes="icon" Width="30" Height="30" ToolTip.Tip="Forward">
                                        <Path Classes="icon small" Data="{StaticResource IconChevronRight}"/>
                                    </Button>
                                    <Button x:Name="WebReload" Grid.Column="2" Classes="icon" Width="30" Height="30" ToolTip.Tip="Reload">
                                        <Path Classes="icon small" Data="{StaticResource IconRefresh}"/>
                                    </Button>
                                    <Border Grid.Column="3" Classes="addressbar" Margin="8,0">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Image x:Name="WebFavicon" Width="14" Height="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="WebAddress" Grid.Column="1" Classes="search address" Margin="8,0,10,0"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="WebOpenExternal" Grid.Column="4" Classes="icon" Width="30" Height="30"
                                            ToolTip.Tip="Open in your browser">
                                        <Path Classes="icon small" Data="{StaticResource IconExternal}"/>
                                    </Button>
                                    <Button x:Name="WebCloseTab" Grid.Column="5" Classes="icon danger" Width="30" Height="30"
                                            ToolTip.Tip="Close this website">
                                        <Path Classes="icon small" Data="{StaticResource IconClose}"/>
                                    </Button>
                                </Grid>
                                <Border x:Name="WebProgress" Grid.Row="1" Height="2" HorizontalAlignment="Left" Width="0"
                                        Background="{DynamicResource AccentGradient}" BoxShadow="{DynamicResource AccentGlowSmall}"/>
                                <!-- A sign-in popup the page opened: shown in place of the page until it closes itself -->
                                <Border x:Name="PopupBanner" Grid.Row="2" IsVisible="False" Padding="14,8"
                                        Background="{DynamicResource AccentFaintBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="0,1,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Path Classes="icon accent" Data="{StaticResource IconShield}" Height="15"/>
                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="PopupTitle" FontWeight="SemiBold" FontSize="12.5"/>
                                            <TextBlock Classes="muted" FontSize="11.5"
                                                       Text="A window opened by the page (sign-in, permissions). It closes by itself when done."/>
                                        </StackPanel>
                                        <Button x:Name="PopupClose" Grid.Column="2" Classes="ghost" Content="Back to the page" Padding="12,5"/>
                                    </Grid>
                                </Border>
                                <Panel x:Name="WebHosts" Grid.Row="3" Margin="1,0,1,1"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- OverDesk's own tab (settings) -->
                    <app:SettingsView x:Name="Settings" IsVisible="False" ZIndex="1"/>

                    <!-- A work (note, list, story...) opened as a tab -->
                    <Border x:Name="WorkPage" IsVisible="False" ZIndex="1" Background="{StaticResource Bg0Brush}"/>

                    <!-- Starting / failed / exited -->
                    <Grid x:Name="TabOverlay" Background="{StaticResource Bg0Brush}" IsVisible="False">
                        <c:SigilBackground x:Name="OverlayWaves" Intensity="0.45"
                                          Accent="{DynamicResource AccentColor}" Accent2="{DynamicResource Accent2Color}"/>
                        <Border x:Name="OverlayCard" Classes="card" Width="460" Padding="34,32"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="14">
                                <Panel Width="96" Height="96" HorizontalAlignment="Center">
                                    <Ellipse x:Name="OverlayHalo" Classes="halo" Width="150" Height="150" Margin="-40"
                                             Fill="{DynamicResource AccentBrush}">
                                        <Ellipse.OpacityMask>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#70000000" Offset="0"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.OpacityMask>
                                    </Ellipse>
                                    <c:Spinner x:Name="OverlaySpinner" Thickness="3" Accent="{DynamicResource AccentColor}"/>
                                    <c:AppIcon x:Name="OverlayIcon" Width="58" Height="58"/>
                                    <Border x:Name="OverlayBadge" Width="26" Height="26" CornerRadius="13"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                                            Background="{StaticResource DangerBrush}" BorderBrush="{StaticResource Bg2Brush}"
                                            BorderThickness="3">
                                        <Path Classes="icon small" Data="{StaticResource IconAlert}" Stroke="White" Height="11"/>
                                    </Border>
                                </Panel>
                                <TextBlock x:Name="OverlayTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="OverlayText" Classes="muted" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
                                    <Button x:Name="OverlayAction" Classes="accent" IsVisible="False"/>
                                    <Button x:Name="OverlayCloseTab" Classes="ghost" Content="Close tab" IsVisible="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Panel>
            </Grid>

            <GridSplitter x:Name="ToolSplitter" Grid.Column="2" Width="3" IsVisible="False" Classes="toolsplitter"
                          ResizeDirection="Columns"/>

            <!-- Tool panel (opens when a tool is clicked) -->
            <Border x:Name="ToolPanel" Grid.Column="3" Background="{StaticResource Bg1Brush}" ClipToBounds="True">
              <Grid>
                <!-- The same room as the dock: the tool stands in it as one big slab -->
                <d:DeckFloor Accent="{DynamicResource AccentColor}" IsHitTestVisible="False"/>
                <d:DepthCard Tilt="False" Radius="18" Margin="10,10,10,4" Accent="{DynamicResource AccentColor}">
                 <Border CornerRadius="17" ClipToBounds="True">
                  <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="14,12,10,10">
                        <d:IconGem3D x:Name="ToolGem" Margin="0,0,10,0" Color="{DynamicResource AccentColor}"
                                     Color2="{DynamicResource Accent2Color}"/>
                        <TextBlock x:Name="ToolTitle" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="ToolReloadButton" Grid.Column="2" Classes="icon capbtn" Width="28" Height="28"
                                Margin="0,0,6,0" ToolTip.Tip="Restart tool">
                            <Path Classes="icon small" Data="{StaticResource IconRefresh}"/>
                        </Button>
                        <Button x:Name="ToolCloseButton" Grid.Column="3" Classes="icon capbtn" Width="28" Height="28"
                                ToolTip.Tip="Close panel">
                            <Path Classes="icon small" Data="{StaticResource IconClose}"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Border x:Name="ToolHost" Background="Transparent"/>
                        <ContentControl x:Name="ToolViewHost" IsVisible="False"/>
                        <StackPanel x:Name="ToolOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="12" Margin="18">
                            <TextBlock x:Name="ToolOverlayText" Classes="muted" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="ToolOverlayAction" Classes="ghost" Content="Retry" HorizontalAlignment="Center"
                                    IsVisible="False"/>
                        </StackPanel>
                    </Grid>
                  </Grid>
                 </Border>
                </d:DepthCard>
              </Grid>
            </Border>

            <!-- Tool strip: one key per tool, set into a recessed rail; "+" adds your own -->
            <Border x:Name="ToolStrip" Grid.Column="4" Background="#0B0B10"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1,0,0,0"
                    BoxShadow="inset 6 0 10 -4 #A0000000">
                <DockPanel Margin="0,10">
                    <Button x:Name="AddToolButton" DockPanel.Dock="Bottom" Classes="icon" Width="40" Height="40"
                            HorizontalAlignment="Center" ToolTip.Tip="Add a tool (or drop a program here)">
                        <Path Classes="icon" Data="{StaticResource IconPlus}"/>
                    </Button>
                    <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="TOOLS" FontSize="8.5" LetterSpacing="1.4"
                               HorizontalAlignment="Center" Margin="0,2,0,10"/>
                    <StackPanel x:Name="ToolButtons" Spacing="6" HorizontalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================================================== overlays above everything -->
        <Grid x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="3" IsVisible="False" IsHitTestVisible="False"
              Background="#CC07070B">
            <Border x:Name="DropFrame" Margin="18" CornerRadius="22" BorderThickness="2"
                    BorderBrush="{DynamicResource AccentBorderBrush}" BoxShadow="{DynamicResource AccentGlowLarge}"
                    Background="{DynamicResource AccentFaintBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <Border Width="84" Height="84" CornerRadius="42" Background="{DynamicResource AccentGradientDiagonal}"
                            BoxShadow="{DynamicResource AccentGlow}" HorizontalAlignment="Center">
                        <Path Classes="icon" Data="{StaticResource IconDrop}" Stroke="White" Height="34"
                              StrokeThickness="2"/>
                    </Border>
                    <TextBlock x:Name="DropTitle" Text="Drop to open as a tab" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DropText" Classes="muted" HorizontalAlignment="Center"
                               Text="Any program works: it will live in OverDesk's top bar."/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Short confirmations ("Copied", "Pinned"...), shown in the top bar where nothing can cover them -->
        <Border x:Name="ToastHost" Grid.Row="0" Classes="toast" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="12,6" IsVisible="False" IsHitTestVisible="False" ZIndex="5">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Path x:Name="ToastIcon" Classes="icon accent" Height="14"/>
                <TextBlock x:Name="ToastText" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <app:TaskLogView x:Name="TaskLog" Grid.Row="0" Grid.RowSpan="3" IsVisible="False"/>
        <app:CommandPaletteView x:Name="Palette" Grid.Row="0" Grid.RowSpan="3" IsVisible="False"/>
        <app:ProgramPickerView x:Name="Picker" Grid.Row="0" Grid.RowSpan="3" IsVisible="False"/>
    </Grid>
</Window>
