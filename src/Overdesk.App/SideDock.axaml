<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Overdesk.App.Controls"
             xmlns:d="using:Overdesk.App.Controls.Depth"
             x:Class="Overdesk.App.SideDock"
             ClipToBounds="True">
    <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
            <!-- The room the widget slabs stand in -->
            <d:DeckFloor Grid.Row="0" Grid.RowSpan="2" Accent="{DynamicResource AccentColor}" IsHitTestVisible="False"/>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Height="44" Margin="14,4,8,0">
                <StackPanel x:Name="HeaderText" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <d:IconGem3D Icon="IconGrid" Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                    <TextBlock Classes="eyebrow" Text="YOUR DESK" VerticalAlignment="Center" Margin="0,0,0,2"/>
                </StackPanel>
                <Button x:Name="CollapseButton" Grid.Column="1" Classes="icon capbtn" Width="28" Height="28"
                        HorizontalAlignment="Center">
                    <Path x:Name="CollapseIcon" Classes="icon small" Data="{StaticResource IconChevronLeft}"/>
                </Button>
            </Grid>

            <!-- ============================================== expanded: widget cards -->
            <ScrollViewer x:Name="Expanded" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CardStack" Margin="12,2,12,14" Spacing="10">

                    <!-- Now playing -->
                    <d:DepthCard x:Name="MediaCard" Cursor="Hand" Accent="{DynamicResource AccentColor}">
                        <Border CornerRadius="16" ClipToBounds="True">
                        <Panel>
                            <!-- Tinted artwork backdrop -->
                            <Border x:Name="MediaBackdrop" Opacity="0.35" IsHitTestVisible="False"/>
                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Color="#9915151D" Offset="0"/>
                                        <GradientStop Color="#F215151D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel Margin="12" Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <d:IconGem3D Icon="IconMusic" Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                                    <TextBlock Classes="eyebrow" Text="NOW PLAYING" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                </StackPanel>

                                <!-- Compact row -->
                                <Grid x:Name="MediaCompact" ColumnDefinitions="Auto,*,Auto">
                                    <d:AlbumDeck3D x:Name="SmallArt" CoverSize="46" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock x:Name="MediaTitle" FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="MediaArtist" Classes="muted" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button x:Name="CompactPlay" Grid.Column="2" Classes="playbtn small" VerticalAlignment="Center">
                                        <Path x:Name="CompactPlayIcon" Classes="icon" Data="{StaticResource IconPlay}"
                                              Stroke="White" Fill="White" Height="12"/>
                                    </Button>
                                </Grid>

                                <c:SeekBar x:Name="CompactSeek" Height="10" IsHitTestVisible="False"
                                           Accent="{DynamicResource AccentColor}" Accent2="{DynamicResource Accent2Color}"/>

                                <!-- Expanded player -->
                                <StackPanel x:Name="MediaDetails" Spacing="12" IsVisible="False">
                                    <d:AlbumDeck3D x:Name="BigArt" CoverSize="150" Reflection="True" HorizontalAlignment="Center"
                                                   Margin="0,6,0,-6"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="BigTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="BigArtist" Classes="muted" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                            <Border Classes="chip"><TextBlock x:Name="MediaSource"/></Border>
                                            <TextBlock x:Name="BigAlbum" Classes="faint" FontSize="11" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <c:SeekBar x:Name="BigSeek" Height="16"
                                                   Accent="{DynamicResource AccentColor}" Accent2="{DynamicResource Accent2Color}"/>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,*,Auto">
                                            <TextBlock x:Name="ElapsedText" Classes="faint mono" FontSize="11" VerticalAlignment="Center"/>
                                            <Button x:Name="Back10" Grid.Column="2" Classes="icon seekjump" ToolTip.Tip="Back 10 seconds">
                                                <TextBlock Text="−10s"/>
                                            </Button>
                                            <Button x:Name="Fwd10" Grid.Column="3" Classes="icon seekjump" ToolTip.Tip="Forward 10 seconds">
                                                <TextBlock Text="+10s"/>
                                            </Button>
                                            <TextBlock x:Name="RemainingText" Grid.Column="5" Classes="faint mono" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,*,Auto">
                                        <Button x:Name="ShuffleButton" Grid.Column="0" Classes="icon capbtn modebtn" ToolTip.Tip="Shuffle">
                                            <Path Classes="icon" Data="{StaticResource IconShuffle}"/>
                                        </Button>
                                        <Button x:Name="PrevButton" Grid.Column="2" Classes="icon capbtn" ToolTip.Tip="Previous">
                                            <Path Classes="icon" Data="{StaticResource IconPrev}" Fill="{StaticResource MutedBrush}"/>
                                        </Button>
                                        <Button x:Name="BigPlay" Grid.Column="3" Classes="playbtn" Margin="10,0">
                                            <Path x:Name="BigPlayIcon" Classes="icon" Data="{StaticResource IconPlay}"
                                                  Stroke="White" Fill="White" Height="16"/>
                                        </Button>
                                        <Button x:Name="NextButton" Grid.Column="4" Classes="icon capbtn" ToolTip.Tip="Next">
                                            <Path Classes="icon" Data="{StaticResource IconNext}" Fill="{StaticResource MutedBrush}"/>
                                        </Button>
                                        <Button x:Name="RepeatButton" Grid.Column="6" Classes="icon capbtn modebtn" ToolTip.Tip="Repeat">
                                            <Panel>
                                                <Path Classes="icon" Data="{StaticResource IconRepeat}"/>
                                                <Border x:Name="RepeatOneBadge" Width="11" Height="11" CornerRadius="6"
                                                        Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right"
                                                        VerticalAlignment="Top" Margin="0,-5,-6,0" IsVisible="False">
                                                    <TextBlock Text="1" FontSize="8" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Panel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <TextBlock x:Name="MediaHint" Classes="faint" FontSize="11" TextWrapping="Wrap" IsVisible="False"/>
                            </StackPanel>
                        </Panel>
                        </Border>
                    </d:DepthCard>

                    <!-- Focus timer -->
                    <d:DepthCard x:Name="FocusCard" Accent="{DynamicResource AccentColor}">
                        <StackPanel Margin="12" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <d:IconGem3D Icon="IconTimer" Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                                    <TextBlock Classes="eyebrow" Text="FOCUS" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                </StackPanel>
                                <StackPanel x:Name="FocusActions" Grid.Column="1" Orientation="Horizontal" Spacing="2"/>
                            </Grid>
                            <StackPanel x:Name="FocusBody" Spacing="6"/>
                        </StackPanel>
                    </d:DepthCard>

                    <!-- System gauges: the gear picks which ones are shown -->
                    <d:DepthCard x:Name="SystemCard" Accent="{DynamicResource AccentColor}">
                        <StackPanel Margin="12" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <d:IconGem3D Icon="IconGauge" Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                                    <TextBlock Classes="eyebrow" Text="SYSTEM" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                </StackPanel>
                                <Button x:Name="MetricsButton" Grid.Column="1" Classes="icon capbtn" Width="24" Height="24"
                                        ToolTip.Tip="Choose what to show">
                                    <Path Classes="icon small" Data="{StaticResource IconSettingsSmall}" Height="12"
                                          StrokeThickness="1.6"/>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="MetricRows" Spacing="12"/>
                            <TextBlock x:Name="MetricsEmpty" Classes="faint" FontSize="11.5" TextWrapping="Wrap" IsVisible="False"
                                       Text="No gauges selected. Use the gear to pick some."/>
                        </StackPanel>
                    </d:DepthCard>

                    <!-- Local AI monitor -->
                    <d:DepthCard x:Name="AiCard" Accent="{DynamicResource AccentColor}">
                        <StackPanel Margin="12" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <d:IconGem3D Icon="IconSparkle" Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                                    <TextBlock Classes="eyebrow" Text="LOCAL AI" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                </StackPanel>
                                <StackPanel x:Name="AiActions" Grid.Column="1" Orientation="Horizontal" Spacing="2"/>
                            </Grid>
                            <StackPanel x:Name="AiBody" Spacing="6"/>
                        </StackPanel>
                    </d:DepthCard>

                    <!-- Projects + running tasks -->
                    <d:DepthCard x:Name="ProjectsCard" Accent="{DynamicResource AccentColor}">
                        <StackPanel Margin="12" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <d:IconGem3D Icon="IconRocket" Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                                    <TextBlock Classes="eyebrow" Text="PROJECTS" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                </StackPanel>
                                <StackPanel x:Name="ProjectsActions" Grid.Column="1" Orientation="Horizontal" Spacing="2"/>
                            </Grid>
                            <StackPanel x:Name="ProjectsBody" Spacing="6"/>
                        </StackPanel>
                    </d:DepthCard>

                    <!-- Git status of the active project -->
                    <d:DepthCard x:Name="GitCard" Accent="{DynamicResource AccentColor}">
                        <StackPanel Margin="12" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <d:IconGem3D Icon="IconBranch" Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                                    <TextBlock Classes="eyebrow" Text="GIT" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                </StackPanel>
                                <StackPanel x:Name="GitActions" Grid.Column="1" Orientation="Horizontal" Spacing="2"/>
                            </Grid>
                            <StackPanel x:Name="GitBody" Spacing="6"/>
                        </StackPanel>
                    </d:DepthCard>

                    <!-- Docker containers -->
                    <d:DepthCard x:Name="DockerCard" Accent="{DynamicResource AccentColor}">
                        <StackPanel Margin="12" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <d:IconGem3D Icon="IconBox" Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                                    <TextBlock Classes="eyebrow" Text="DOCKER" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                </StackPanel>
                                <StackPanel x:Name="DockerActions" Grid.Column="1" Orientation="Horizontal" Spacing="2"/>
                            </Grid>
                            <StackPanel x:Name="DockerBody" Spacing="6"/>
                        </StackPanel>
                    </d:DepthCard>

                    <!-- Localhost ports -->
                    <d:DepthCard x:Name="PortsCard" Accent="{DynamicResource AccentColor}">
                        <StackPanel Margin="12" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <d:IconGem3D Icon="IconServer" Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                                    <TextBlock Classes="eyebrow" Text="LOCALHOST" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                </StackPanel>
                                <Button x:Name="RefreshPorts" Grid.Column="1" Classes="icon capbtn" Width="24" Height="24"
                                        ToolTip.Tip="Refresh">
                                    <Path Classes="icon small" Data="{StaticResource IconRefresh}" Height="11"/>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="PortList" Spacing="4"/>
                            <TextBlock x:Name="PortsEmpty" Classes="faint" FontSize="11.5" Text="No dev servers are listening."/>
                        </StackPanel>
                    </d:DepthCard>

                    <!-- Clipboard -->
                    <d:DepthCard x:Name="ClipCard" Accent="{DynamicResource AccentColor}">
                        <StackPanel Margin="12" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <d:IconGem3D Icon="IconClipboard" Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                                    <TextBlock Classes="eyebrow" Text="CLIPBOARD" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                </StackPanel>
                                <Button x:Name="ClearClips" Grid.Column="1" Classes="icon capbtn" Width="24" Height="24"
                                        ToolTip.Tip="Clear history">
                                    <Path Classes="icon small" Data="{StaticResource IconClose}" Height="10"/>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="SnippetList" Spacing="4"/>
                            <StackPanel x:Name="ClipList" Spacing="4"/>
                            <TextBlock x:Name="ClipsEmpty" Classes="faint" FontSize="11.5" TextWrapping="Wrap"
                                       Text="Copy some text anywhere; it shows up here. Click to copy it again."/>
                        </StackPanel>
                    </d:DepthCard>

                    <!-- Notes -->
                    <d:DepthCard x:Name="NotesCard" Accent="{DynamicResource AccentColor}">
                        <StackPanel Margin="12" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <d:IconGem3D Icon="IconNote" Color="{DynamicResource AccentColor}" Color2="{DynamicResource Accent2Color}"/>
                                <TextBlock Classes="eyebrow" Text="SCRATCHPAD" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            </StackPanel>
                            <TextBox x:Name="Notes" Classes="notes" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                                     PlaceholderText="Quick notes, TODOs, snippets…"/>
                        </StackPanel>
                    </d:DepthCard>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Height="18" VerticalAlignment="Top" IsHitTestVisible="False"
                    IsVisible="{Binding #Expanded.IsVisible}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#FF0E0E14" Offset="0"/>
                        <GradientStop Color="#000E0E14" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Grid.Row="1" Height="26" VerticalAlignment="Bottom" IsHitTestVisible="False"
                    IsVisible="{Binding #Expanded.IsVisible}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#000A0A0F" Offset="0"/>
                        <GradientStop Color="#FF0A0A0F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ============================================== collapsed: icon rail -->
            <StackPanel x:Name="Rail" Grid.Row="1" Spacing="14" HorizontalAlignment="Center" Margin="0,6,0,0"
                        IsVisible="False">
                <Button x:Name="RailMedia" Classes="icon railkey" Width="42" Height="42" CornerRadius="12" ToolTip.Tip="Now playing">
                    <Border Width="34" Height="34" CornerRadius="9" ClipToBounds="True"
                            Background="{DynamicResource AccentGradientDiagonal}">
                        <Panel>
                            <Path Classes="icon" Data="{StaticResource IconMusic}" Stroke="White" Height="15"/>
                            <Image x:Name="RailArt" Stretch="UniformToFill"/>
                        </Panel>
                    </Border>
                </Button>
                <Button x:Name="RailSystem" Classes="icon railkey" Width="42" Height="42" CornerRadius="12" ToolTip.Tip="System">
                    <StackPanel Spacing="0">
                        <TextBlock x:Name="RailCpu" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="CPU" FontSize="8" Classes="faint" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RailPorts" Classes="icon railkey" Width="42" Height="42" CornerRadius="12" ToolTip.Tip="Localhost">
                    <StackPanel Spacing="0">
                        <TextBlock x:Name="RailPortCount" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="PORTS" FontSize="8" Classes="faint" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RailClips" Classes="icon railkey" Width="42" Height="42" CornerRadius="12" ToolTip.Tip="Clipboard">
                    <Path Classes="icon" Data="{StaticResource IconClipboard}"/>
                </Button>
                <Button x:Name="RailNotes" Classes="icon railkey" Width="42" Height="42" CornerRadius="12" ToolTip.Tip="Scratchpad">
                    <Path Classes="icon" Data="{StaticResource IconNote}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
