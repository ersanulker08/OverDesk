<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ============================================================ icons -->
    <Style Selector="Path.icon">
        <Setter Property="Stroke" Value="{StaticResource MutedBrush}"/>
        <Setter Property="StrokeThickness" Value="1.7"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <!-- Only the height is fixed: a uniformly stretched shape is drawn at its top-left, so a fixed square box
             would push narrow icons (pause, play) off-center. The width follows the icon's own proportions. -->
        <Setter Property="Height" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Stroke" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Path.icon.small">
        <Setter Property="Height" Value="12"/>
        <Setter Property="StrokeThickness" Value="1.9"/>
    </Style>
    <Style Selector="Path.icon.large">
        <Setter Property="Height" Value="22"/>
    </Style>
    <Style Selector="Path.icon.accent">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ============================================================ buttons -->
    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Square icon button used in bars -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pressed">
        <Setter Property="RenderTransform" Value="scale(0.9)"/>
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg4Brush}"/>
    </Style>
    <Style Selector="Button.icon:pointerover Path.icon">
        <Setter Property="Stroke" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Button.icon.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="Button.icon.selected Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.icon.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#33FF4D5E"/>
    </Style>
    <Style Selector="Button.icon.danger:pointerover Path.icon">
        <Setter Property="Stroke" Value="{StaticResource DangerBrush}"/>
    </Style>

    <!-- Primary call to action: accent gradient pill -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.accent:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    </Style>
    <Style Selector="Button.accent:pressed">
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.accent Path.icon">
        <Setter Property="Stroke" Value="White"/>
    </Style>

    <!-- Secondary button: dark glass with a hairline border -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg4Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- ============================================================ top bar tabs -->
    <Style Selector="Border.tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,0,5,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="128"/>
        <Setter Property="MaxWidth" Value="230"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
            </Transitions>
        </Setter>
    </Style>
    <!-- Glowing accent line under the active tab: grows out of the middle when the tab becomes active -->
    <Style Selector="Border.tabline">
        <Setter Property="Height" Value="2"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Margin" Value="14,0,14,-1"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlowSmall}"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform" Value="scaleX(0.2)"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="QuinticEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.tab.active Border.tabline">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform" Value="scaleX(1)"/>
    </Style>
    <Style Selector="Border.tab:pointerover:not(.active) Border.tabline">
        <Setter Property="Opacity" Value="0.35"/>
        <Setter Property="RenderTransform" Value="scaleX(0.45)"/>
    </Style>
    <Style Selector="Border.tab:pointerover">
        <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
    </Style>
    <Style Selector="Border.tab.active">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
    </Style>
    <Style Selector="Border.tab.internal TextBlock.title">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.6"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Border.tab.internal">
        <Setter Property="MinWidth" Value="120"/>
    </Style>
    <Style Selector="Border.tab TextBlock.title">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="8,0,4,0"/>
    </Style>
    <Style Selector="Border.tab:pointerover TextBlock.title">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Border.tab.active TextBlock.title">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Border.tab Button.tabclose">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="Border.tab:pointerover Button.tabclose, Border.tab.active Button.tabclose">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Unread badge on a program tab (macOS reads the Dock's badges) -->
    <Style Selector="Border.badge">
        <Setter Property="MinWidth" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Margin" Value="4,0,2,0"/>
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BoxShadow" Value="0 0 8 0 #80FF4D5E"/>
    </Style>

    <!-- The pinned "Home" tab at the start of the bar -->
    <Style Selector="Button.hometab">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- ============================================================ right tool strip -->
    <Style Selector="Button.tool">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.tool /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.tool:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.06)"/>
    </Style>
    <Style Selector="Button.tool:pressed">
        <Setter Property="RenderTransform" Value="scale(0.92)"/>
    </Style>
    <Style Selector="Button.tool.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlowSmall}"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Button.tool.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Ellipse.halo">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Ellipse.halo.breathing">
        <Style.Animations>
            <Animation Duration="0:0:2.4" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.35"/>
                    <Setter Property="Width" Value="128"/>
                    <Setter Property="Height" Value="128"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.95"/>
                    <Setter Property="Width" Value="168"/>
                    <Setter Property="Height" Value="168"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.35"/>
                    <Setter Property="Width" Value="128"/>
                    <Setter Property="Height" Value="128"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================================ cards, chips, text -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="BoxShadow" Value="{StaticResource CardShadow}"/>
    </Style>
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="7,3"/>
    </Style>
    <Style Selector="Border.chip TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="1.6"/>
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.faint">
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
    </Style>

    <!-- ============================================================ home page tiles -->
    <Style Selector="Button.tile">
        <Setter Property="Width" Value="118"/>
        <Setter Property="Height" Value="116"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.28"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.tile /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.tile:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-4px)"/>
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
    </Style>
    <Style Selector="Button.tile:pressed">
        <Setter Property="RenderTransform" Value="translateY(-1px) scale(0.97)"/>
    </Style>
    <Style Selector="Button.tile.add /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}"/>
    </Style>
    <Style Selector="Button.tile.add:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
    </Style>
    <Style Selector="Button.tile:pointerover Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.tile Border.tileglow">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.tile:pointerover Border.tileglow">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Smaller tiles in the program picker -->
    <Style Selector="Button.tile.pick">
        <Setter Property="Width" Value="108"/>
        <Setter Property="Height" Value="112"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Search results rows -->
    <Style Selector="Button.result">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style Selector="Button.result:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.result.highlight /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>

    <!-- ============================================================ text input -->
    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="PlaceholderForeground" Value="{StaticResource FaintBrush}"/>
    </Style>
    <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement, TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.searchbox">
        <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BoxShadow" Value="{StaticResource NoShadow}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.searchbox:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlow}"/>
    </Style>

    <!-- ============================================================ menus, tooltips -->
    <Style Selector="ContextMenu, MenuFlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="MenuItem Path.icon">
        <Setter Property="Height" Value="14"/>
    </Style>
    <Style Selector="MenuItem:pointerover Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="MenuItem.danger:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#33FF4D5E"/>
    </Style>
    <Style Selector="MenuItem.danger:pointerover Path.icon">
        <Setter Property="Stroke" Value="{StaticResource DangerBrush}"/>
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="{StaticResource StrokeBrush}"/>
        <Setter Property="Margin" Value="6,4"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style Selector="GridSplitter.toolsplitter">
        <Setter Property="Background" Value="{StaticResource StrokeBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="GridSplitter.toolsplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ============================================================ side dock -->

    <Style Selector="Button.playbtn">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource AccentGradientDiagonal}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.playbtn.small">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>
    <!-- A glossy orb: lit cap and dark underside drawn as inner shadows, a solid "foot" under it, accent bloom -->
    <Style Selector="Button.playbtn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="inset 0 2 3 -1 #A0FFFFFF, inset 0 -5 8 0 #66000000, 0 3 0 0 #B0000000, 0 8 18 0 #66000000"/>
    </Style>
    <Style Selector="Button.playbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="inset 0 2 3 -1 #C0FFFFFF, inset 0 -5 8 0 #55000000, 0 4 0 0 #B0000000, 0 10 24 0 #80000000"/>
    </Style>
    <Style Selector="Button.playbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="inset 0 3 6 0 #70000000, inset 0 -1 2 0 #40FFFFFF, 0 1 0 0 #B0000000"/>
    </Style>
    <Style Selector="Button.playbtn:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-1px) scale(1.06)"/>
    </Style>
    <Style Selector="Button.playbtn:pressed">
        <Setter Property="RenderTransform" Value="translateY(2px) scale(0.97)"/>
    </Style>
    <Style Selector="Button.playbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.playbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentGradientDiagonal}"/>
    </Style>

    <!-- Shuffle / repeat toggles: accent when on, with a small dot underneath -->
    <Style Selector="Button.modebtn.on Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.modebtn.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}"/>
    </Style>
    <Style Selector="Button.modebtn.unsupported">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>
    <Style Selector="Button.seekjump">
        <Setter Property="Width" Value="NaN"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="2,0"/>
    </Style>
    <Style Selector="Button.seekjump TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style Selector="Button.seekjump:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- Gauge picker rows in the dock's settings flyout -->
    <Style Selector="CheckBox.metric">
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="MinWidth" Value="230"/>
    </Style>
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- A clickable row inside a dock card (ports, clipboard entries) -->
    <!-- Dock rows are keycaps: a raised top with a lit edge standing on a dark base; they press down when clicked -->
    <Style Selector="Button.dockrow">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{StaticResource KeycapBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KeycapEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.dockrow /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 3 0 0 #E0050507, 0 5 8 0 #60000000"/>
    </Style>
    <Style Selector="Button.dockrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource KeycapBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="BoxShadow" Value="0 3 0 0 #E0050507, 0 6 14 0 #90000000"/>
    </Style>
    <Style Selector="Button.dockrow:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    </Style>
    <Style Selector="Button.dockrow:pressed">
        <Setter Property="RenderTransform" Value="translateY(2px)"/>
    </Style>
    <Style Selector="Button.dockrow:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 1 0 0 #E0050507"/>
    </Style>
    <Style Selector="Button.dockrow:pointerover Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <!-- The folded dock's rail: square keycaps -->
    <Style Selector="Button.railkey /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource KeycapBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KeycapEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="0 4 0 0 #E0050507, 0 7 12 0 #70000000"/>
    </Style>
    <Style Selector="Button.railkey:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource KeycapBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="BoxShadow" Value="0 4 0 0 #E0050507, 0 7 16 0 #90000000"/>
    </Style>
    <Style Selector="Button.railkey:pressed">
        <Setter Property="RenderTransform" Value="translateY(3px)"/>
    </Style>
    <Style Selector="Button.railkey:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 1 0 0 #E0050507"/>
    </Style>

    <!-- Read-only rows are wells pressed into the slab -->
    <Style Selector="Border.dockrowstatic">
        <Setter Property="Background" Value="#0B0B10"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="BoxShadow" Value="inset 0 2 4 0 #C0000000, inset 0 -1 0 0 #18FFFFFF"/>
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Menlo, Consolas, Cascadia Mono, monospace"/>
    </Style>

    <Style Selector="TextBox.notes">
        <Setter Property="Background" Value="#0B0B10"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Menlo, Consolas, Cascadia Mono, monospace"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="PlaceholderForeground" Value="{StaticResource FaintBrush}"/>
    </Style>
    <!-- The scratchpad is a well sunk into its slab -->
    <Style Selector="TextBox.notes /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="inset 0 3 6 0 #C0000000, inset 0 -1 0 0 #14FFFFFF"/>
    </Style>
    <Style Selector="TextBox.notes:pointerover /template/ Border#PART_BorderElement, TextBox.notes:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ============================================================ toast -->
    <Style Selector="Border.toast">
