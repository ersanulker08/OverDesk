    <!-- ============================================================ web strip -->
    <Style Selector="Button.webpill">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="9,0,11,0"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
