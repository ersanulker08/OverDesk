<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The host loads this assembly from <manifest folder>/bin; host assemblies must not be copied next to it. -->
    <OutDir>bin/</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\Overdesk.Core\Overdesk.Core.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
